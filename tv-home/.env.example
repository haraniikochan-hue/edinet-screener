# Optional server-side credentials. Copy to .env.local, never dashboard/.
# Legacy optional endpoint. Not used by the default HIP-3 watchlist.
MARKET_DATA_URL=
MARKET_DATA_TOKEN=
# Unsplash Developers > Your apps > New Application > Keys > Access Key.
# The Secret Key is not required. Restart the server after changing this file.
UNSPLASH_ACCESS_KEY=
# Register http://127.0.0.1:4173/ as Spotify's redirect URI for local testing.
# A public client ID is not a secret. Never put a Spotify client secret here.
SPOTIFY_CLIENT_ID=
PORT=4173
HOST=127.0.0.1
