<?xml version="1.0" encoding="utf-8"?>
<!-- No key filtering: on this TV it stops a held volume button from repeating (SettingsKeyService).
     Window changes only, without their content, to see Prime Video come to the front (AppRedirect). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:description="@string/settings_key_description"
    android:notificationTimeout="0" />
